# -----------------------------------------------------------------------------
# CONTOH VARIABEL LINGKUNGAN (.env.example)
# Catatan: File ini HANYA TEMPLATE DOKUMENTASI.
# Konfigurasi aktif saat ini sudah terpasang otomatis di website/src/config.js.
# Anda TIDAK PERLU membuat atau mengisi file .env jika sudah memakai config.js.
# -----------------------------------------------------------------------------

# Cloudflare Turnstile Public Site Key
VITE_TURNSTILE_SITE_KEY=

# Web3Forms Access Key (Pengiriman email otomatis ke Gmail)
VITE_WEB3FORMS_ACCESS_KEY=

# Backend Endpoint Form Contact
VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit


