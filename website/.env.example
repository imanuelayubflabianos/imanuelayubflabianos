# Cloudflare Turnstile Public Site Key (Frontend Safe)
# Ganti dengan Site Key Turnstile publik kamu dari Cloudflare Dashboard
# Mode: Managed | Hostname: imanuelayubflabianos.github.io
VITE_TURNSTILE_SITE_KEY=

# Backend Endpoint Form Contact (Serverless / Cloudflare Worker)
# URL API backend yang memverifikasi token Turnstile dengan Secret Key & mengirim email
# Contoh: https://portfolio-contact-api.imanuelayubflabianos.workers.dev/api/contact
VITE_CONTACT_ENDPOINT=

